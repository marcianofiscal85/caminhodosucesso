rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só pode ler e gravar os próprios dados
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /dias/{data} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
