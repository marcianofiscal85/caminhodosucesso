rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Funções ---------- */
    function logado() { return request.auth != null; }
    function emailVerificado() {
      return logado() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function meuEmail() { return request.auth.token.email.lower(); }

    // Única pessoa que pode gerar e gerenciar convites
    function ehAdmin() { return emailVerificado() && meuEmail() == 'marcianofiscal85@gmail.com'; }

    function caminhoMembro(uid) { return /databases/$(database)/documents/membros/$(uid); }
    function caminhoConvite(cod) { return /databases/$(database)/documents/convites/$(cod); }
    function ehMembro() { return logado() && exists(caminhoMembro(request.auth.uid)); }

    /* ---------- Dados do app: cada pessoa só acessa os próprios ---------- */
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid && (ehMembro() || ehAdmin());

      match /dias/{data} {
        allow read, write: if logado() && request.auth.uid == uid && (ehMembro() || ehAdmin());
      }
    }

    /* ---------- Convites ---------- */
    match /convites/{codigo} {
      // Só o admin cria convites, sempre "novos" e vinculados a um e-mail em minúsculas
      allow create: if ehAdmin()
        && request.resource.data.keys().hasOnly(['email', 'nota', 'criadoEm', 'expiraEm', 'usado', 'revogado'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.criadoEm == request.time
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm > request.time
        && request.resource.data.usado == false
        && request.resource.data.revogado == false;

      // O admin lista tudo; o convidado só enxerga o convite emitido para o próprio e-mail
      allow list: if ehAdmin();
      allow get: if ehAdmin() || (emailVerificado() && resource.data.email == meuEmail());

      // Admin: apenas revogar. Convidado: apenas resgatar o próprio convite válido,
      // e somente junto com a criação do seu registro de membro (mesma operação atômica)
      allow update: if (
          ehAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revogado'])
          && request.resource.data.revogado == true
        ) || (
          emailVerificado()
          && resource.data.email == meuEmail()
          && resource.data.usado == false
          && resource.data.revogado == false
          && request.time < resource.data.expiraEm
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'usadoPor', 'usadoEm'])
          && request.resource.data.usado == true
          && request.resource.data.usadoPor == request.auth.uid
          && request.resource.data.usadoEm == request.time
          && existsAfter(caminhoMembro(request.auth.uid))
          && getAfter(caminhoMembro(request.auth.uid)).data.codigo == codigo
        );

      allow delete: if ehAdmin();
    }

    /* ---------- Membros (quem tem acesso) ---------- */
    match /membros/{uid} {
      allow get: if logado() && (request.auth.uid == uid || ehAdmin());
      allow list: if ehAdmin();

      // Só é possível virar membro resgatando um convite válido do próprio e-mail
      allow create: if emailVerificado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'codigo', 'criadoEm'])
        && request.resource.data.email == meuEmail()
        && request.resource.data.criadoEm == request.time
        && request.resource.data.codigo is string
        && exists(caminhoConvite(request.resource.data.codigo))
        && get(caminhoConvite(request.resource.data.codigo)).data.email == meuEmail()
        && get(caminhoConvite(request.resource.data.codigo)).data.usado == false
        && get(caminhoConvite(request.resource.data.codigo)).data.revogado == false
        && request.time < get(caminhoConvite(request.resource.data.codigo)).data.expiraEm
        && getAfter(caminhoConvite(request.resource.data.codigo)).data.usado == true
        && getAfter(caminhoConvite(request.resource.data.codigo)).data.usadoPor == uid;

      allow update: if false;
      // Admin pode remover o acesso de alguém
      allow delete: if ehAdmin();
    }

    // Qualquer outro caminho é negado por padrão.
  }
}
